# ---------------------------------------------------------------------------
# Database (NeonDB)
# ---------------------------------------------------------------------------
# Neon connection string. Use the pooled connection string for serverless.
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=

# Restricted role used for tenant-scoped reads with RLS.
# Create the role and generate this URL with:
#   node scripts/setup-app-role.mjs
DATABASE_AUTHENTICATED_URL=

# ---------------------------------------------------------------------------
# Neon Local (dev) — banco local sem usar o de produção
# ---------------------------------------------------------------------------
# O container `neondatabase/neon_local` cria um branch a partir de
# `NEON_LOCAL_PARENT_BRANCH_ID`. O valor abaixo é o branch `development`.
# ATENÇÃO: o branch default do projeto Neon é `production`
# (br-royal-term-bbveh4nm) — NUNCA use esse ID como parent.
#
# 1) rode `bun run setup:local` (preenche este arquivo e valida o Docker)
# 2) rode `bun run dev:local` (sobe o container, aplica migrations e inicia o app)
NEON_LOCAL=true
NEON_API_KEY=
NEON_PROJECT_ID=delicate-firefly-32175564
NEON_LOCAL_PARENT_BRANCH_ID=br-holy-truth-bb9hmcnq
# Opcional: fixa um branch existente (conecta nele em vez de criar um novo a
# partir do parent). Bom para reaproveitar o mesmo banco de dev sempre:
# NEON_LOCAL_BRANCH_ID=br-...
# O `setup:local` preenche DATABASE_URL (postgres://neon:npg@localhost:5432/neondb)
# na raiz E em apps/app/.env, porque o Next lê o arquivo do app e ignora o da
# raiz. Também deixa DATABASE_AUTHENTICATED_URL vazio no dev: o Neon Local é
# HTTP-only e não suporta a transação com set_config usada pelo RLS — o app
# desabilita a leitura com RLS automaticamente quando NEON_LOCAL=true.
# Opcional, só se o app rodar dentro do compose:
# NEON_LOCAL_SQL_ENDPOINT=http://db:5432/sql

# ---------------------------------------------------------------------------
# Neon Realtime (Reatividade em tempo real via WebSockets)
# ---------------------------------------------------------------------------
# Ative com `neon realtime enable` ou no painel do Neon.
# Segredo privado para selar consultas no servidor (começa com nrt_live_1...)
NEON_REALTIME_SECRET=
# URL pública do WebSocket (ex: wss://live.neon.tech/...)
NEXT_PUBLIC_NEON_REALTIME_URL=


# ---------------------------------------------------------------------------
# Plataforma / Super Admin
# ---------------------------------------------------------------------------
# CSV de e-mails (case-insensitive) promovidos a super_admin no bootstrap e
# protegidos contra revogação pelo painel/CLI. Ex.: dono@empresa.com,ops@empresa.com
PLATFORM_SUPER_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth Infra (Dash & Sentinel) — opcional.
# BETTER_AUTH_IDENTIFY_URL é a URL do projeto no Dash
# (ex: https://kv.better-auth.com/api/v1/projects/<id>). Ela configura
# automaticamente o identify no cliente, o origin correspondente na CSP e a
# base do KV usada pelo servidor. BETTER_AUTH_KV_URL e
# NEXT_PUBLIC_BETTER_AUTH_KV_URL continuam suportadas como opcionais, para
# quem já usa os nomes antigos.
BETTER_AUTH_API_KEY=
BETTER_AUTH_IDENTIFY_URL=
BETTER_AUTH_KV_URL=
NEXT_PUBLIC_BETTER_AUTH_KV_URL=

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# UploadThing (perfil e logo da igreja)
UPLOADTHING_TOKEN=

# ---------------------------------------------------------------------------
# Upstash Redis & QStash (Filas e Notificações Agendadas)
# ---------------------------------------------------------------------------
# Redis para rate limiting, filas e persistência de agendamentos
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# QStash para mensageria assíncrona e webhooks de notificações
# Localmente: npx @upstash/qstash-cli@latest dev (usa QSTASH_URL=http://localhost:8080)
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Segredo do endpoint de cron/jobs (bearer `Authorization: Bearer <CRON_SECRET>`).
# Gere com: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# PWA & Web Push Notifications (Nativo VAPID & OneSignal)
# ---------------------------------------------------------------------------
# Chaves VAPID nativas para Web Push (geradas via `web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@openministry.app

# Integração opcional com OneSignal (https://documentation.onesignal.com/docs/en/web-push-setup)
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ---------------------------------------------------------------------------
# Brevo (Emails Transacionais e Notificações)
# ---------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=notificacoes@openministry.app
BREVO_SENDER_NAME=OpenMinistry

# ---------------------------------------------------------------------------
# Sentry (Error Tracking & Performance Monitoring)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://701eae11ff84f3405b299c851146adb1@o4511768401018880.ingest.us.sentry.io/4512411126988800
SENTRY_DSN=https://701eae11ff84f3405b299c851146adb1@o4511768401018880.ingest.us.sentry.io/4512411126988800
SENTRY_ORG=open-mission
SENTRY_PROJECT=open-ministry
SENTRY_AUTH_TOKEN=

