# ---------------------------------------------------------------------------
# Database (NeonDB)
# ---------------------------------------------------------------------------
# Neon connection string. Use the pooled connection string for serverless.
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=

# Restricted role used for tenant-scoped reads with RLS.
# Create the role and generate this URL with:
#   node scripts/setup-app-role.mjs
DATABASE_AUTHENTICATED_URL=

# ---------------------------------------------------------------------------
# Neon Realtime (Reatividade em tempo real via WebSockets)
# ---------------------------------------------------------------------------
# Ative com `neon realtime enable` ou no painel do Neon.
# Segredo privado para selar consultas no servidor (começa com nrt_live_1...)
NEON_REALTIME_SECRET=
# URL pública do WebSocket (ex: wss://live.neon.tech/...)
NEXT_PUBLIC_NEON_REALTIME_URL=


# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# UploadThing (perfil e logo da igreja)
UPLOADTHING_TOKEN=

# ---------------------------------------------------------------------------
# Upstash Redis & QStash (Filas e Notificações Agendadas)
# ---------------------------------------------------------------------------
# Redis para rate limiting, filas e persistência de agendamentos
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# QStash para mensageria assíncrona e webhooks de notificações
# Localmente: npx @upstash/qstash-cli@latest dev (usa QSTASH_URL=http://localhost:8080)
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ---------------------------------------------------------------------------
# PWA & Web Push Notifications (Nativo VAPID & OneSignal)
# ---------------------------------------------------------------------------
# Chaves VAPID nativas para Web Push (geradas via `web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@openministry.app

# Integração opcional com OneSignal (https://documentation.onesignal.com/docs/en/web-push-setup)
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ---------------------------------------------------------------------------
# Brevo (Emails Transacionais e Notificações)
# ---------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=notificacoes@openministry.app
BREVO_SENDER_NAME=OpenMinistry

# ---------------------------------------------------------------------------
# Sentry (Error Tracking & Performance Monitoring)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://701eae11ff84f3405b299c851146adb1@o4511768401018880.ingest.us.sentry.io/4512411126988800
SENTRY_DSN=https://701eae11ff84f3405b299c851146adb1@o4511768401018880.ingest.us.sentry.io/4512411126988800
SENTRY_ORG=open-mission
SENTRY_PROJECT=open-ministry
SENTRY_AUTH_TOKEN=

